{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Test Sample Cases",
            "command": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}/Test.py",
                "-f",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        }
    ]
}